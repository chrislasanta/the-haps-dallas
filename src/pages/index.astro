---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PostCard from '../components/PostCard.astro';

const allPosts = await getCollection('blog');
const sorted = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const featured = sorted.find(p => p.data.featured) ?? sorted[0];
const recent = sorted.filter(p => p.id !== featured.id).slice(0, 4);

const categories = [
  { label: 'Dining', emoji: '🍽️', href: '/blog?category=Dining' },
  { label: 'Outdoors', emoji: '🌸', href: '/blog?category=Outdoors' },
  { label: 'Arts & Culture', emoji: '🎨', href: '/blog?category=Arts+%26+Culture' },
  { label: 'Entertainment', emoji: '🎉', href: '/blog?category=Entertainment' },
  { label: 'Family', emoji: '👨‍👩‍👧', href: '/blog?category=Family' },
  { label: 'Free & Cheap', emoji: '💸', href: '/blog?category=Free+%26+Cheap' },
];
---

<Layout title="Home">
  <Header />

  <main class="flex-1">

    <!-- Hero -->
    <section class="relative overflow-hidden text-center py-16 px-4" style="background: linear-gradient(160deg, #FFD6E7 0%, #E8D5F5 50%, #FFD6E7 100%);">
      <!-- decorative blobs -->
      <div class="absolute top-4 left-8 text-4xl opacity-40 sparkle" style="animation-delay: 0s;">✨</div>
      <div class="absolute top-10 right-12 text-3xl opacity-40 sparkle" style="animation-delay: 0.8s;">💖</div>
      <div class="absolute bottom-6 left-16 text-3xl opacity-30 sparkle" style="animation-delay: 1.5s;">🌸</div>
      <div class="absolute bottom-4 right-8 text-4xl opacity-30 sparkle" style="animation-delay: 0.4s;">⭐</div>
      <div class="absolute top-1/2 left-4 text-2xl opacity-20 sparkle" style="animation-delay: 2s;">🦋</div>
      <div class="absolute top-1/3 right-4 text-2xl opacity-20 sparkle" style="animation-delay: 1.2s;">🦋</div>

      <div class="relative max-w-2xl mx-auto">
        <p class="text-xs font-extrabold uppercase tracking-widest mb-3" style="color: var(--color-pink-hot);">✨ updated every single week ✨</p>
        <h2 class="text-5xl sm:text-6xl mb-4 leading-tight drop-shadow-sm" style="font-family: var(--font-family-display); color: var(--color-purple-dark);">
          The Best Things<br/>to Do in Dallas!
        </h2>
        <p class="text-base sm:text-lg mb-8 leading-relaxed font-semibold" style="color: #7B2D8B;">
          your fave weekly guide to DFW 💕 eats, adventures, art, events &amp; everything in between
        </p>
        <a
          href="/blog"
          class="inline-block font-extrabold px-8 py-3 rounded-full shadow-lg hover:scale-105 transition-transform text-white text-sm uppercase tracking-wide"
          style="background: linear-gradient(135deg, var(--color-pink-hot), var(--color-purple));"
        >
          ✨ browse all posts ✨
        </a>
      </div>
    </section>

    <!-- Category Bubbles -->
    <section class="bg-white py-4 px-4 shadow-sm overflow-x-auto">
      <div class="flex gap-2 justify-center min-w-max mx-auto">
        {categories.map(cat => (
          <a
            href={cat.href}
            class="flex items-center gap-1.5 px-4 py-2 rounded-full text-sm font-extrabold transition-all hover:scale-105 shadow-sm border-2 border-pink-200 hover:border-pink-400"
            style="background: var(--color-pink-bg); color: var(--color-purple-dark);"
          >
            <span>{cat.emoji}</span>
            <span>{cat.label}</span>
          </a>
        ))}
      </div>
    </section>

    <div class="max-w-5xl mx-auto px-4 py-10">

      <!-- Featured -->
      {featured && (
        <section class="mb-12">
          <div class="flex items-center gap-3 mb-5">
            <span class="text-lg">💖</span>
            <span class="font-extrabold uppercase tracking-widest text-sm" style="color: var(--color-pink-hot);">featured this week</span>
            <div class="flex-1 h-0.5 rounded-full" style="background: linear-gradient(to right, var(--color-pink-light), transparent);"></div>
          </div>
          <PostCard
            title={featured.data.title}
            slug={featured.id}
            date={featured.data.date}
            description={featured.data.description}
            category={featured.data.category}
            coverImage={featured.data.coverImage}
            featured={true}
          />
        </section>
      )}

      <!-- Recent Posts -->
      {recent.length > 0 && (
        <section>
          <div class="flex items-center gap-3 mb-6">
            <span class="text-lg">🌸</span>
            <span class="font-extrabold uppercase tracking-widest text-sm" style="color: var(--color-pink-hot);">recent posts</span>
            <div class="flex-1 h-0.5 rounded-full" style="background: linear-gradient(to right, var(--color-pink-light), transparent);"></div>
            <a href="/blog" class="text-xs font-extrabold hover:underline" style="color: var(--color-purple);">see all ✨</a>
          </div>
          <div class="grid sm:grid-cols-2 gap-6">
            {recent.map(post => (
              <PostCard
                title={post.data.title}
                slug={post.id}
                date={post.data.date}
                description={post.data.description}
                category={post.data.category}
                coverImage={post.data.coverImage}
              />
            ))}
          </div>
        </section>
      )}

      <!-- CTA Banner -->
      <section class="mt-16 rounded-3xl p-8 text-center text-white shadow-xl relative overflow-hidden"
               style="background: linear-gradient(135deg, var(--color-pink-hot), var(--color-purple));">
        <div class="absolute top-3 right-6 text-3xl opacity-30">✨</div>
        <div class="absolute bottom-3 left-6 text-3xl opacity-30">💖</div>
        <h3 class="text-2xl font-extrabold mb-2 drop-shadow" style="font-family: var(--font-family-display);">
          never miss the haps! 🎀
        </h3>
        <p class="text-white/80 mb-5 max-w-md mx-auto text-sm font-semibold">
          new posts every week — bookmark this page and check back every sunday for fresh dallas picks! 💕
        </p>
        <a
          href="/blog"
          class="inline-block bg-white font-extrabold px-6 py-2.5 rounded-full shadow-md hover:scale-105 transition-transform text-sm"
          style="color: var(--color-pink-hot);"
        >
          read all posts 💖
        </a>
      </section>

    </div>
  </main>

  <Footer />
</Layout>
