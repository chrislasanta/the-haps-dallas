---
const categories = ['Dining', 'Outdoors', 'Arts & Culture', 'Entertainment', 'Family', 'Free & Cheap'];
const categoryEmojis: Record<string, string> = {
  'Dining': '🍽️',
  'Outdoors': '🌸',
  'Arts & Culture': '🎨',
  'Entertainment': '🎉',
  'Family': '👨‍👩‍👧',
  'Free & Cheap': '💸',
};
---

<footer style="background: linear-gradient(135deg, #C471ED 0%, #FF4B8A 100%);" class="mt-16 text-white">
  <!-- wavy top border -->
  <div class="overflow-hidden leading-none -mb-px">
    <svg viewBox="0 0 1200 60" xmlns="http://www.w3.org/2000/svg" class="w-full" style="fill: var(--color-pink-bg);">
      <path d="M0,30 C150,60 350,0 600,30 C850,60 1050,0 1200,30 L1200,0 L0,0 Z"/>
    </svg>
  </div>

  <div class="max-w-5xl mx-auto px-4 pt-4 pb-10 grid sm:grid-cols-3 gap-8">
    <div>
      <div class="text-2xl font-bold mb-2 drop-shadow" style="font-family: var(--font-family-display);">
        The Haps Dallas
      </div>
      <p class="text-white/80 text-sm leading-relaxed">
        Your weekly dose of DFW fun! Written by Amy — a total Dallasite who loves this city way too much. 💖
      </p>
    </div>

    <div>
      <h4 class="font-extrabold text-sm uppercase tracking-wider mb-3 text-white/90">✨ Categories</h4>
      <ul class="space-y-1.5">
        {categories.map(cat => (
          <li>
            <a
              href={`/blog?category=${encodeURIComponent(cat)}`}
              class="text-white/75 text-sm hover:text-white font-semibold transition-colors"
            >
              {categoryEmojis[cat]} {cat}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h4 class="font-extrabold text-sm uppercase tracking-wider mb-3 text-white/90">💌 Stay in the Loop</h4>
      <p class="text-white/75 text-sm mb-4 leading-relaxed">New posts every week! Bookmark this page so you never miss the haps. 🎀</p>
      <a
        href="/about"
        class="inline-block bg-white text-[var(--color-pink-hot)] font-extrabold px-5 py-2 rounded-full shadow-md hover:scale-105 transition-transform text-sm"
      >
        Meet Amy 💕
      </a>
    </div>
  </div>

  <div class="border-t border-white/20 text-center text-white/60 text-xs py-4">
    made with 💖 in dallas, tx · © {new Date().getFullYear()} the haps dallas
  </div>
</footer>
